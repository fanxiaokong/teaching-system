# ══════════════════════════════════════════════════════════════
#  teaching-system 专用 MySQL 调优（本机只有 1.6 GB 内存，默认配置吃不下）
#  放在 /etc/mysql/mysql.conf.d/ 下，因为该目录在 my.cnf 里被 Includedir
#  且文件名以 zz- 开头 → 排在官方 50-server.cnf 之后，覆盖生效
# ══════════════════════════════════════════════════════════════
[mysqld]

# 只监听回环：外网连不上，必须走 SSH 隧道（和 sqlite-web 一个思路）
bind-address = 127.0.0.1

# ── 内存：默认 buffer pool 128M + performance_schema(~200M) + X plugin(~50M)
#    在 1.6G 的机器上会把 Apache(mod_wsgi) 挤到 swap。下面逐项砍。
innodb_buffer_pool_size = 128M
performance_schema = OFF
mysqlx = OFF

# 连接数：这是个小站，50 已经非常宽裕
max_connections = 50
table_open_cache = 400
thread_cache_size = 16

# 慢日志开着但阈值放宽，避免正常查询刷盘
slow_query_log = 1
long_query_time = 2

# 字符集：全站中文数据，统一 utf8mb4
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# 注意：没有改 innodb_flush_log_at_trx_commit，保持默认 1（每次提交 fsync）。
# 这个库写入极少（秒级几次），换安全，值。

[client]
default-character-set = utf8mb4
