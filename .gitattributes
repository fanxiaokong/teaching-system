# 统一换行符：文本文件用 LF，避免跨平台（macOS/Windows/Linux）协作时 CRLF/LF 混乱
* text=auto

# 源码
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.cnf text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制（不做任何换行/合并处理）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.zip binary
*.gz binary
*.pdf binary
*.mov binary
*.mp4 binary
*.dmg binary
*.exe binary
*.apk binary
