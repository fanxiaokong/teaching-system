{
  "name": "teaching-system-desktop",
  "productName": "教学管理系统",
  "version": "1.4.9",
  "description": "教学管理系统 Windows 客户端",
  "main": "src/main.js",
  "author": "教学管理系统",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.teachingsystem.desktop",
    "productName": "教学管理系统",
    "copyright": "Copyright © 2026 教学管理系统",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "教学管理系统",
      "artifactName": "教学管理系统-安装版-${version}.${ext}",
      "uninstallDisplayName": "教学管理系统",
      "language": "2052"
    },
    "portable": {
      "artifactName": "教学管理系统-绿色版-${version}.${ext}"
    }
  }
}
