# 教学管理系统 · 服务端配置示例
# 复制为 .env 后按需修改。setup.py 首次运行会自动生成一份带随机密钥的 .env。
# 所有变量均为可选，留空即使用默认值；敏感值请勿提交进仓库。

# ---- 服务基础 ----
PORT=8000
BASE_PATH=
FLASK_ENV=development

# ---- 密钥（生产务必改为随机强值，可：openssl rand -hex 32）----
SECRET_KEY=CHANGE_ME_SECRET

# ---- 数据目录（上传文件、课程资源等存放处）----
DATA_DIR=server/data

# ---- 首次启动创建的管理员账号 ----
ADMIN_USERNAME=admin
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- 数据库后端：本系统仅支持 MySQL 8 ----
NETLAB_DB_BACKEND=mysql
NETLAB_MYSQL_HOST=127.0.0.1
NETLAB_MYSQL_PORT=3306
NETLAB_MYSQL_USER=admin
NETLAB_MYSQL_PASSWORD=CHANGE_ME_PASSWORD
NETLAB_MYSQL_DATABASE=netlab
# 提示：数据库 netlab 需提前存在；运行 setup.py 时会尝试自动创建（密码已填的前提下）。

# ---- 口令存储：plain（明文，后台可直接查看/修改）或 hash（PBKDF2）----
NETLAB_PASSWORD_MODE=plain
